# agents/.env.example — copy to agents/.env and fill in locally. Never commit .env.
# Placeholders only.
#
# The NVIDIA provider key is not an application environment variable.
# It lives only in Nightshift's Providers tab. Do not add it here.
#
# From this container, 127.0.0.1 is the container. Use host.docker.internal.
# Nightshift headers on every call:
#   Authorization: Bearer <METERLESS_RUNTIME_TOKEN>
#   meterless-app: <METERLESS_APP>
#   meterless-scope: user

ZETARIS_REST_URL=http://host.docker.internal:8888/api/v1.0
ZETARIS_ORG_ID=1
ZETARIS_API_KEY=
ZETARIS_JDBC_URL=
ZETARIS_USER=
ZETARIS_PASSWORD=

METERLESS_BASE_URL=http://host.docker.internal:8088/v1
METERLESS_APP=floodsense-eu
METERLESS_SCOPE=user
METERLESS_RUNTIME_TOKEN=

MODEL_FAST=nvidia/nemotron-3.5-lightning-30b-a3b
MODEL_DEEP=nvidia/nemotron-3-super-120b-a12b
LLM_TIMEOUT_S=180
PGVECTOR_DSN=

# Runtime switches (read by floodsense_agents.settings). auto = live when the URL above is set, otherwise the offline
# stand-in: FakeZetaris (the contract views as SQLite seed rows) and FakeNightshift (deterministic). Set to `fake` to
# force offline mode (tests, UI work without credits) or `live` to refuse to start without credentials.
ZETARIS_MODE=auto
LLM_MODE=auto
# HITL checkpointer: sqlite under CHECKPOINT_DIR (the compose volume), memory fallback with a warning. CHECKPOINTER=sqlite refuses the fallback.
CHECKPOINTER=auto
CHECKPOINT_DIR=/data/checkpoints
SKEPTIC_MAX_ROUNDS=3
JUDGE_REPAIR_ROUNDS=1
JUDGE_MIN_SCORE=0.7
NUMERIC_TOLERANCE=0.02

# Feature flags, read by floodsense_agents.settings. v1.0 defaults are in docs/GAMEPLAN.md.
# FF_SKEPTIC and FF_HITL are implemented and on. FF_JUDGE is implemented (nodes/judge.py) but stays off here until the
# team flips the v0.10.0 default at stand-up; set FF_JUDGE=true to score claims before the approval interrupt.
# FF_LIVE_DATA switches the agents from floodsense_seed.* to floodsense.*. Memory, document RAG and the stretch flags
# stay off because that behaviour does not exist yet. Host sync credentials belong in ingestion/.env, not here.
FF_LIVE_DATA=false
FF_SKEPTIC=true
FF_HITL=true
FF_HMEM=false
FF_JUDGE=false
FF_RAG_DOCS=false
FF_SEMANTIC_CACHE=false
FF_CACHED_REPLAY=false
FF_EFAS=false
FF_EXTRA_SEGMENTS=false
