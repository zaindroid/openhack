# Copy to ingestion/.env and fill in locally. Never commit the copy.
# Placeholders only.
#
# The NVIDIA provider key is not an application environment variable.
# It lives only in Nightshift's Providers tab.
#
# Ingestion scripts run on the host, so 127.0.0.1 reaches the local Zetaris.
# Containers use host.docker.internal (see agents/.env.example).

ZETARIS_REST_URL=http://127.0.0.1:8888/api/v1.0
ZETARIS_ORG_ID=1
ZETARIS_API_KEY=
ZETARIS_JDBC_URL=
ZETARIS_USER=
ZETARIS_PASSWORD=

# Object storage for EMS footprints and OSM extracts. Leave empty until used.
# Migrations reference these as ${S3_...} placeholders, never as literals.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
