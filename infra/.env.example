APP_NAME=whycore-app
APP_PORT=8080
# data: duckdb (default, seed CSVs) | postgres | zetaris
DATA_BACKEND=duckdb
ZETARIS_REST=http://zetaris:8888/api/v1.0
ZETARIS_USER=admin@zetaris.com
ZETARIS_PASSWORD=change-me
ZETARIS_PREFIX=
ZETARIS_ORG_ID=1
DATABASE_URL=postgresql://app:app@localhost:5432/app
# model: see whycore/model.py. Single endpoint (Meterless Nightshift hotspot or NIM), or MODEL_ROUTE + route variables.
# Unset everything = offline templater. infra/model_hello.py --route <r> smoke-tests a route.
MODEL_ROUTE=nim
MODEL_BASE_URL=
MODEL_API_KEY=
# route A: Meterless Nightshift hotspot (laptop over Tailscale); model ids as Nightshift lists them in GET /v1/models
METERLESS_BASE_URL=http://<laptop-tailscale-ip>:<port>/v1
METERLESS_API_KEY=
METERLESS_REASON=meterless/deep
METERLESS_FAST=meterless/fast
# route B: NVIDIA NIM (build.nvidia.com key)
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_API_KEY=
NIM_REASON=nvidia/nemotron-3.5-super-vl-120b-a12b
NIM_FAST=nvidia/nemotron-3.5-lightning-30b-a3b
# route C: local vLLM over Tailscale, one host per role (infra/models/README.md)
LOCAL_REASON_BASE_URL=
LOCAL_REASON_API_KEY=
LOCAL_REASON=
LOCAL_FAST_BASE_URL=
LOCAL_FAST_API_KEY=
LOCAL_FAST=
# per-role overrides (win over the route) and the fallback tried after retries
MODEL_REASON_BASE_URL=
MODEL_REASON_API_KEY=
MODEL_FAST_BASE_URL=
MODEL_FAST_API_KEY=
MODEL_FALLBACK_ROUTE=nim
MODEL_REASON_FALLBACK=nvidia/nemotron-3.5-super-vl-120b-a12b
MODEL_FAST_FALLBACK=
MODEL_REASON=
MODEL_FAST=
MODEL_THINKING=off
MODEL_CONCURRENCY=8
METERLESS_APP=whycore-app
MEMORY_DIR=/srv/data/memory
MAX_SIGNALS=5
