APP_NAME=whycore-app
APP_PORT=8080
# data: duckdb (default, seed CSVs) | postgres | zetaris
DATA_BACKEND=duckdb
ZETARIS_REST=http://zetaris:8888/api/v1.0
ZETARIS_USER=admin@zetaris.com
ZETARIS_PASSWORD=change-me
ZETARIS_PREFIX=
ZETARIS_ORG_ID=1
DATABASE_URL=postgresql://app:app@localhost:5432/app
# model: Meterless OpenAI-compatible endpoint; unset = offline templater
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_REASON=nvidia/nemotron-3.5-super-vl-120b-a12b
MODEL_FAST=nvidia/nemotron-3-nano
METERLESS_APP=whycore-app
MEMORY_DIR=/srv/data/memory
MAX_SIGNALS=5
